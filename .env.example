# Copy this file to .env and fill in your keys. Never commit .env.

# --- Claude API (tailors resumes and cover letters) ---
# Get a key at https://console.anthropic.com/ (API usage is billed separately from a Claude.ai plan)
ANTHROPIC_API_KEY=

# Optional: which models to use
# ANTHROPIC_MODEL=claude-sonnet-5-5        # tailoring
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5    # quick ranking and suggestions

# --- Adzuna (job search, free) ---
# Register at https://developer.adzuna.com/ to get an app ID and key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Server ---
# PORT=3000
# DATA_DIR=./data
